# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no repositório

# Token principal (obrigatório)
GITHUB_TOKEN=<seu_github_pat_aqui>

# Tokens adicionais para paralelismo (opcional)
# Cada token extra permite +1 repo simultâneo com cota independente de Search API
# Crie PATs read-only em: https://github.com/settings/tokens
# GITHUB_TOKEN_2=<segundo_pat>
# GITHUB_TOKEN_3=<terceiro_pat>
# GITHUB_TOKEN_4=<quarto_pat>

# Uso via CLI:
# python scanner.py                              → usa config padrão
# python scanner.py -o minha-org                 → sobrescreve org
# python scanner.py -r repo1 repo2 repo3         → repos específicos
# python scanner.py --concurrency 4              → 4 repos simultâneos (default com 4 tokens)
# python scanner.py --json-only                  → só JSON
# python scanner.py --md-only                    → só Markdown
